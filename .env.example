# ==============================================================================
# DFLowNovo: Google Cloud Platform & Training Configuration
# ==============================================================================
# Fill in your secrets and GCP project details below.
# This file is loaded automatically by the launch and remote execution scripts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hugging Face Credentials
# ------------------------------------------------------------------------------
# Required for downloading the ProteomeTools dataset (InstaDeepAI/ms_proteometools)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 2. Google Cloud Platform (GCP) Configuration
# ------------------------------------------------------------------------------
# Set your GCP Project ID (find via `gcloud projects list`)
GCP_PROJECT=your_gcp_project_id_here

# GCP Compute Engine Zone (e.g., europe-west4-a, us-central1-a)
GCP_ZONE=europe-west4-a

# Name of the VM instance to create/run
GCP_VM_NAME=dfm-train-a100

# Remote directory path on the GCP VM
GCP_REMOTE_DIR=~/dfm-joelresearch

# Name of the tmux session on the VM for background training
GCP_TMUX_SESSION=dfm-train

# ------------------------------------------------------------------------------
# 3. Hardware & Accelerator Specifications
# ------------------------------------------------------------------------------
# Recommended primary configuration: 1x NVIDIA A100 (40GB VRAM)
GCP_MACHINE_TYPE=a2-highgpu-1g
GCP_ACCELERATOR_TYPE=nvidia-tesla-a100
GCP_ACCELERATOR_COUNT=1
GCP_BOOT_DISK_GB=500
GCP_IMAGE_FAMILY=common-cu124-ubuntu-2204
GCP_IMAGE_PROJECT=deeplearning-platform-release

# Budget fallback configuration (if A100 quota is not available):
# GCP_MACHINE_TYPE=g2-standard-24
# GCP_ACCELERATOR_TYPE=nvidia-l4
# GCP_ACCELERATOR_COUNT=1

# ------------------------------------------------------------------------------
# 4. Training Hyperparameters
# ------------------------------------------------------------------------------
BATCH_SIZE=128
ACCUMULATE_GRAD_BATCHES=4
EPOCHS=30
LEARNING_RATE=3e-4
WEIGHT_DECAY=0.01
NUM_WORKERS=8
TOP_K_PEAKS=200
NOISING_SCHEME=mask
LENGTH_NOISING=true
LENGTH_NOISING_PROB=0.1

# ------------------------------------------------------------------------------
# 5. Validation, Inference & Beam Decoding
# ------------------------------------------------------------------------------
EVAL_EVERY=2
EVAL_MAX_BATCHES=64
INFERENCE_STEPS=20
TOP_K_LENGTHS=3
LENGTH_BEAM_ALPHA=0.1
GUIDANCE_SCALE=1.0

# ------------------------------------------------------------------------------
# 6. Paths & Monitoring
# ------------------------------------------------------------------------------
OUTPUT_DIR=artifacts
HF_DATASETS_CACHE=data/cache
DEVICE=cuda

# Optional: TensorBoard port (default: 6006)
TENSORBOARD_PORT=6006
