# Google Cloud project / VM identity (required for scripts/gcp_*.sh)
GCP_PROJECT=joelgedeon-project
GCP_ZONE=europe-west4-a
GCP_VM_NAME=dfm-train-a100
GCP_REMOTE_DIR=~/dfm-joelresearch
GCP_TMUX_SESSION=dfm-train

# Recommended Google Cloud VM settings for HC-PT training (~2.7M spectra).
#
# Primary (recommended): NVIDIA A100 40GB
# If A100 quota is unavailable in europe-west4-a, try us-central1-a or use L4 fallback below.
GCP_MACHINE_TYPE=a2-highgpu-1g
GCP_ACCELERATOR_TYPE=nvidia-tesla-a100
GCP_ACCELERATOR_COUNT=1
GCP_BOOT_DISK_GB=500
GCP_IMAGE_FAMILY=common-cu124-ubuntu-2204
GCP_IMAGE_PROJECT=deeplearning-platform-release
#
# Budget fallback if A100 quota is unavailable: NVIDIA L4 24GB
# GCP_MACHINE_TYPE=g2-standard-24
# GCP_ACCELERATOR_TYPE=nvidia-l4
# GCP_ACCELERATOR_COUNT=1
#
# Create VM example (adjust project/zone):
# gcloud compute instances create dfm-train-a100 \
#   --machine-type=a2-highgpu-1g \
#   --zone=us-central1-a \
#   --accelerator=type=nvidia-tesla-a100,count=1 \
#   --boot-disk-size=500GB \
#   --image-family=ubuntu-2204-lts \
#   --image-project=ubuntu-os-cloud \
#   --maintenance-policy=TERMINATE \
#   --scopes=storage-full,cloud-platform
#
# Training defaults (also set in src/config/defaults.py)
BATCH_SIZE=128
EPOCHS=30
LEARNING_RATE=3e-4
WEIGHT_DECAY=0.01
NUM_WORKERS=8
TOP_K_PEAKS=200
INFERENCE_STEPS=50
EVAL_EVERY=2
EVAL_MAX_BATCHES=64
TRAIN_SPLIT=train
VALID_SPLIT=validation
OUTPUT_DIR=artifacts
DEVICE=cuda
